<form action="{{ current_store.search_path }}" accept-charset="UTF-8" method="get">
  <div id="SC-GlobalSearch" class="relative">
    <input
      type="search"
      name="q"
      id="q"
      data-search-input
      autocomplete="off"
      placeholder="{{ "header.search.placeholder" | t }}"
      class="peer h-[44px] w-full rounded-[8px] border-none bg-[hsl(0,0%,97%)] pl-[43px] pr-[var(--sc-spacing-medium)] shadow-none outline-none transition-colors duration-200 placeholder:text-[hsl(0,0%,0%,0.5)] placeholder:transition-colors placeholder:duration-200 focus:bg-[hsl(var(--sc-color-primary-h),60%,96%)] focus:placeholder:text-[hsl(var(--sc-color-primary-h),60%,80%)]">
    {%- render "shared/icons/search", style_class: "pointer-events-none absolute left-[18px] top-1/2 h-[15px] w-[15px] -translate-y-1/2 fill-[hsl(0,0%,0%,0.5)] transition-colors duration-200 peer-focus:fill-[hsl(var(--sc-color-primary-h),60%,70%)]" %}
  </div>
</form>
